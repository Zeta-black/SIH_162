# FIRETRACE environment configuration
# Copy this file to .env and fill in your own values. NEVER commit .env.

# --- NASA FIRMS -------------------------------------------------------------
# Free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/area/
# Read server-side only. It is never sent to the browser or written to logs.
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Comma-separated FIRMS products, tried in order.
FIRMS_SOURCES=VIIRS_NOAA21_NRT,VIIRS_NOAA20_NRT,MODIS_NRT

# Default area of interest: west,south,east,north
FIRMS_DEFAULT_BBOX=68.0,6.5,97.5,36.0
# Default is a one-day India query. Change deliberately for a broader window.
FIRMS_DEFAULT_DAY_RANGE=1

# --- Server -----------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model behaviour --------------------------------------------------------
# Top probability below this is reported as UNKNOWN instead of a forced guess.
UNKNOWN_ABSTENTION_THRESHOLD=0.45
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_MEDIUM_THRESHOLD=0.50

# --- Feature radii (km) -----------------------------------------------------
FACILITY_SEARCH_RADIUS_KM=12.0
FACILITY_ONSITE_KM=0.75
RECURRENCE_RADIUS_KM=1.0
RECURRENCE_LOOKBACK_DAYS=60
DENSITY_RADIUS_KM=5.0

# --- Priority score weights (need not sum to 1; they are normalised) --------
PRIORITY_WEIGHT_CONFIDENCE=0.20
PRIORITY_WEIGHT_INDUSTRIAL_CLASS=0.25
PRIORITY_WEIGHT_THERMAL=0.20
PRIORITY_WEIGHT_PROXIMITY=0.15
PRIORITY_WEIGHT_ABNORMALITY=0.10
PRIORITY_WEIGHT_RECENCY=0.10
